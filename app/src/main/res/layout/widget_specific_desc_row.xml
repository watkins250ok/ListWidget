<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_specific_desc_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_item_card_bg"
    android:padding="10dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/widget_specific_desc_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESCRIPTION"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_specific_desc_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="web"
        android:linksClickable="true"
        android:text="Description text goes here..."
        android:textColor="#F1F5F9"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />
</LinearLayout>
