<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_item_card_bg"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Checkbox / Category Icon -->
    <ImageView
        android:id="@+id/widget_item_check_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_widget_checkbox_unchecked" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Title"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/widget_item_meta_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp">

            <TextView
                android:id="@+id/widget_item_due_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 DUE: TODAY"
                android:textColor="#F472B6"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/widget_meta_badge_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_item_tag_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Design"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:background="@drawable/widget_tag_badge_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optional description preview..."
            android:textColor="#E2E8F0"
            android:textSize="10.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="1dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
